# Copy to .env and fill in real values. Never commit .env.

# Neon/Vercel Postgres connection string (required for admin, enquiries, settings)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Session signing secret — REQUIRED in production (the app refuses to start without it).
# Generate: openssl rand -base64 32
ADMIN_SECRET=""

# Used once by `npx prisma db seed` to create/rotate the admin login (min 10 chars).
ADMIN_SEED_PASSWORD=""
# Optional: admin login email (default support@uranusenterprises.in)
# ADMIN_SEED_EMAIL="support@uranusenterprises.in"

# Public site origin used in metadata, sitemap, robots and structured data.
# Must match the domain that actually serves 200 (not one that redirects) —
# www.uranusenterprises.in 301s to the apex, so this must be the apex.
NEXT_PUBLIC_SITE_URL="https://uranusenterprises.in"

# Google Analytics 4 measurement ID (analytics are disabled when unset)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Search Console "HTML tag" verification code (the content= value only,
# not the full <meta> tag). Search Console → Settings → Ownership verification
# → HTML tag. Renders as <meta name="google-site-verification"> when set.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
