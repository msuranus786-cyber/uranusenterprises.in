# Copy to .env and fill in real values. Never commit .env.

# Neon/Vercel Postgres connection string (required for admin, enquiries, settings)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Session signing secret — REQUIRED in production (the app refuses to start without it).
# Generate: openssl rand -base64 32
ADMIN_SECRET=""

# Used once by `npx prisma db seed` to create/rotate the admin login (min 10 chars).
ADMIN_SEED_PASSWORD=""
# Optional: admin login email (default admin@uranus.in)
# ADMIN_SEED_EMAIL="admin@uranus.in"

# Public site origin used in metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL="https://www.uranusenterprises.in"

# Google Analytics 4 measurement ID (analytics are disabled when unset)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
